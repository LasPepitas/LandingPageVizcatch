---
interface Props {
  class?: string;
  elevation?: 'default' | 'high';
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

const { class: className = '', elevation = 'default', padding = 'md' } = Astro.props;

const elevationStyles = {
  default: 'bg-[#FFFFFF] border border-[#E8E5DE]',
  high: 'bg-[#FDFCFB] border border-[#DFDCD5] shadow-[0_1px_3px_rgba(18,19,22,0.04)]'
};

const paddingStyles = {
  none: '',
  sm: 'p-4',
  md: 'p-6 sm:p-8',
  lg: 'p-8 sm:p-12'
};
---

<div class={`rounded-lg ${elevationStyles[elevation]} ${paddingStyles[padding]} ${className}`}>
  <slot />
</div>
