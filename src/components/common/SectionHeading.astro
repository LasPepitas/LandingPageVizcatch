---
interface Props {
  tag?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { tag, title, subtitle, align = 'left', class: className = '' } = Astro.props;
---

<div class={`space-y-3 ${align === 'center' ? 'text-center max-w-3xl mx-auto' : 'text-left max-w-3xl'} ${className}`}>
  {tag && (
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-semibold uppercase tracking-wider bg-[#18191F] text-[#FF1E38] border border-[#23242A]">
        {tag}
      </span>
    </div>
  )}
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display text-[#FFFFFF] tracking-tight leading-[1.05]">
    {title}
  </h2>
  {subtitle && (
    <p class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal">
      {subtitle}
    </p>
  )}
</div>
