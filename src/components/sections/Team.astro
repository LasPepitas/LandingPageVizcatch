---
import Container from '../common/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import PeruFlag from '../icons/PeruFlag.astro';
import Code from '../icons/Code.astro';

const teamMembers = [
  {
    name: 'Noe U. Machaca',
    role: 'Lead Full Stack Developer',
    focus: 'Arquitectura Limpia & Sistemas Escalables',
    bio: 'Especialista en diseño de arquitecturas de software escalables, desarrollo full code y liderazgo técnico. Garantiza el rendimiento de plataformas transaccionales de misión crítica.',
    skills: ['Astro', 'React', 'Node.js', 'PostgreSQL', 'DDD']
  },
  {
    name: 'Victor R. Maye',
    role: 'Full Stack Developer',
    focus: 'Desarrollo End-to-End & Performance',
    bio: 'Enfocado en construir interfaces ultra rápidas y backends robustos. Experto en optimización, ecosistema de React y flujos de trabajo ágiles de nivel corporativo.',
    skills: ['React', 'TypeScript', 'Express', 'Tailwind CSS', 'Git']
  },
  {
    name: 'Julio S. Eduardo',
    role: 'QA & UI/UX Engineer',
    focus: 'Experiencia de Usuario & Testing Automatizado',
    bio: 'Diseña interfaces de alta conversión B2B y asegura la resiliencia del producto final mediante pruebas automatizadas, accesibilidad y metodologías rigurosas de QA.',
    skills: ['Figma', 'Cypress', 'Jest', 'UI/UX Design', 'Web Vitals']
  },
  {
    name: 'Rene R. Ccoyto',
    role: 'Backend Developer',
    focus: 'Ecosistema Transaccional & APIs',
    bio: 'Arquitecto de lógica de negocio y bases de datos relacionales. Experto en integraciones complejas como pasarelas de pago, facturación electrónica y despliegue cloud.',
    skills: ['Node.js', 'Python', 'Docker', 'PostgreSQL', 'AWS']
  }
];
---

<section id="equipo" class="py-24 lg:py-32 bg-[#0A0A0E] border-b border-[#23242A]">
  <Container>
    <div class="space-y-16 max-w-5xl mx-auto">
      <SectionHeading 
        tag="EQUIPO DE INGENIERÍA"
        title="ARQUITECTOS Y ESPECIALISTAS SENIOR"
        subtitle="Profesionales basados en Puno con experiencia comprobada en plataformas transaccionales, infraestructura cloud e integraciones locales."
      />

      <!-- Team Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {teamMembers.map((member) => (
          <div class="p-6 rounded-lg bg-[#101114] border border-[#23242A] hover:border-[#7368CF]/40 transition-all flex flex-col justify-between space-y-5 group">
            <div class="space-y-4">
              <!-- Avatar Placeholder with Initials & Red Accent -->
              <div class="w-12 h-12 rounded-lg bg-[#18191E] border border-[#2A2B32] flex items-center justify-center text-sm font-bold text-[#FFFFFF] group-hover:border-[#7368CF] transition-colors">
                {member.name.split(' ').map(n => n[0]).join('')}
              </div>

              <div>
                <h3 class="text-base font-bold text-[#FFFFFF] tracking-tight group-hover:text-[#7368CF] transition-colors">
                  {member.name}
                </h3>
                <div class="text-[11px] font-semibold text-[#7368CF] uppercase tracking-wider mt-0.5">
                  {member.role}
                </div>
                <div class="text-[11px] text-[#71717A] mt-0.5">
                  {member.focus}
                </div>
              </div>

              <p class="text-xs text-[#A1A1AA] leading-relaxed font-normal">
                {member.bio}
              </p>
            </div>

            <!-- Member Skills -->
            <div class="pt-3 border-t border-[#23242A] flex flex-wrap gap-1.5">
              {member.skills.map((skill) => (
                <span class="px-2 py-0.5 rounded bg-[#18191E] text-[#A1A1AA] text-[10px] font-medium border border-[#2A2B32]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Trust Strip below Team -->
      <div class="p-6 rounded-lg bg-[#101114] border border-[#23242A] flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-[#A1A1AA]">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-[#18191E] border border-[#2A2B32] flex items-center justify-center text-[#7368CF] shrink-0">
            <Code class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-[#FFFFFF]">Revisión de Código por Pares (Peer Review):</span>
            <span class="text-[#71717A] block sm:inline sm:ml-1">Cada sprint pasa por validaciones de tipado estricto y pruebas automáticas.</span>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <PeruFlag class="w-4 h-3" />
          <span class="font-semibold text-[#FFFFFF]">Equipo 100% en Puno, Perú</span>
        </div>
      </div>
    </div>
  </Container>
</section>
