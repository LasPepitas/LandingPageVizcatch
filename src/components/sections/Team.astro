---
import Container from '../common/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import PeruFlag from '../icons/PeruFlag.astro';
import Code from '../icons/Code.astro';

const teamMembers = [
  {
    name: 'Franco Ramírez',
    role: 'Lead Software Architect',
    focus: 'Arquitectura Limpia & Sistemas Distribuidos',
    bio: 'Especialista en diseño de microservicios, bases de datos PostgreSQL y optimización de rendimiento edge. 12+ años liderando proyectos de software de misión crítica.',
    skills: ['Astro', 'TypeScript', 'Go', 'PostgreSQL', 'DDD']
  },
  {
    name: 'Renzo Morales',
    role: 'Head of Cloud & DevOps',
    focus: 'Infraestructura Cloud & Resiliencia',
    bio: 'Arquitecto cloud certificado AWS. Diseña entornos de alta concurrencia, pipelines de CI/CD automatizados y seguridad perimetral con Cloudflare.',
    skills: ['AWS', 'Docker', 'Linux', 'Cloudflare', 'GitHub Actions']
  },
  {
    name: 'Diego Salazar',
    role: 'Senior Backend & Payments Lead',
    focus: 'Ecosistema Transaccional & SUNAT',
    bio: 'Especialista en pasarelas de pago peruanas (Niubiz, Culqi, Yape/Plin) y conectividad directa con facturación electrónica SUNAT XML sin intermediarios.',
    skills: ['Node.js', 'REST APIs', 'GraphQL', 'SUNAT XML', 'Redis']
  },
  {
    name: 'Valeria Torres',
    role: 'UI/UX Systems Engineer',
    focus: 'Design Systems & Frontend Performance',
    bio: 'Diseña interfaces de usuario de alta fidelidad orientadas a conversión B2B, accesibilidad WCAG y puntuación perfecta 100/100 en Google PageSpeed.',
    skills: ['React', 'Tailwind CSS', 'Figma', 'Web Vitals', 'Atomic UI']
  }
];
---

<section id="equipo" class="py-24 lg:py-32 bg-[#0A0A0E] border-b border-[#23242A]">
  <Container>
    <div class="space-y-16 max-w-5xl mx-auto">
      <SectionHeading 
        tag="EQUIPO DE INGENIERÍA"
        title="ARQUITECTOS Y ESPECIALISTAS SENIOR"
        subtitle="Profesionales basados en Lima con experiencia comprobada en plataformas transaccionales, infraestructura cloud e integraciones locales."
      />

      <!-- Team Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {teamMembers.map((member) => (
          <div class="p-6 rounded-lg bg-[#101114] border border-[#23242A] hover:border-[#FF1E38]/40 transition-all flex flex-col justify-between space-y-5 group">
            <div class="space-y-4">
              <!-- Avatar Placeholder with Initials & Red Accent -->
              <div class="w-12 h-12 rounded-lg bg-[#18191E] border border-[#2A2B32] flex items-center justify-center text-sm font-bold text-[#FFFFFF] group-hover:border-[#FF1E38] transition-colors">
                {member.name.split(' ').map(n => n[0]).join('')}
              </div>

              <div>
                <h3 class="text-base font-bold text-[#FFFFFF] tracking-tight group-hover:text-[#FF1E38] transition-colors">
                  {member.name}
                </h3>
                <div class="text-[11px] font-semibold text-[#FF1E38] uppercase tracking-wider mt-0.5">
                  {member.role}
                </div>
                <div class="text-[11px] text-[#71717A] mt-0.5">
                  {member.focus}
                </div>
              </div>

              <p class="text-xs text-[#A1A1AA] leading-relaxed font-normal">
                {member.bio}
              </p>
            </div>

            <!-- Member Skills -->
            <div class="pt-3 border-t border-[#23242A] flex flex-wrap gap-1.5">
              {member.skills.map((skill) => (
                <span class="px-2 py-0.5 rounded bg-[#18191E] text-[#A1A1AA] text-[10px] font-medium border border-[#2A2B32]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Trust Strip below Team -->
      <div class="p-6 rounded-lg bg-[#101114] border border-[#23242A] flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-[#A1A1AA]">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-[#18191E] border border-[#2A2B32] flex items-center justify-center text-[#FF1E38] shrink-0">
            <Code class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-[#FFFFFF]">Revisión de Código por Pares (Peer Review):</span>
            <span class="text-[#71717A] block sm:inline sm:ml-1">Cada sprint pasa por validaciones de tipado estricto y pruebas automáticas.</span>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <PeruFlag class="w-4 h-3" />
          <span class="font-semibold text-[#FFFFFF]">Equipo 100% en Lima, Perú</span>
        </div>
      </div>
    </div>
  </Container>
</section>
