---
import "../styles/global.css";
import Navbar from "../components/navigation/Navbar.astro";
import Footer from "../components/navigation/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Vizcatch Analytics — Ingeniería de Software a Medida | Puno, Perú",
  description = "Firma de ingeniería de software en Puno, Perú. Construimos CRMs, E-commerce de alto tráfico y plataformas a medida con arquitectura full code, cero dependencias de plantillas y 100% propiedad del cliente.",
  image = new URL(
    "/og-image.png",
    Astro.site || "https://vizcatch-analytics.com",
  ).href,
  canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://vizcatch-analytics.com",
  ).href,
} = Astro.props;

const siteUrl = "https://vizcatch-analytics.com";

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Vizcatch Analytics",
      url: siteUrl,
      logo: `${siteUrl}/isotipo.png`,
      description:
        "Firma de ingeniería de software a medida en Puno, Perú. Especialistas en CRMs, E-commerce de alto tráfico, Landings de conversión y desarrollo Full Code.",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Puno",
        addressCountry: "PE",
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+51-965-100-861",
        contactType: "sales",
        areaServed: "PE",
        availableLanguage: ["Spanish", "English"],
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Vizcatch Analytics",
      publisher: { "@id": `${siteUrl}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#080808] text-[#FFFFFF]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/isotipo.png" />
    <link rel="apple-touch-icon" href="/isotipo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Typography: Bebas Neue + Syne + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data JSON-LD -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schemaOrg)}
    />
  </head>
  <body
    class="min-h-screen flex flex-col bg-[#080808] text-[#FFFFFF] antialiased selection:bg-[#7368CF] selection:text-[#FFFFFF]"
  >
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Client Scripts for Lenis Smooth Scroll and Direct Tactile States -->
    <script>
      import Lenis from "lenis";

      const lenis = new Lenis({
        duration: 0.9,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: "vertical",
        smoothWheel: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
  </body>
</html>
