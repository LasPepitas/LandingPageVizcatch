---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import WhatsApp from '../components/icons/WhatsApp.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Faq from '../components/sections/Faq.astro';
---

<BaseLayout
  title="Contacto & Cotización de Software | Vizcatch Perú"
  description="Contactá al equipo de ingeniería de Vizcatch en Lima, Perú. Cotizá tu proyecto de CRM, E-commerce, Landing o software a medida hoy mismo."
>
  <!-- Header -->
  <section class="py-24 lg:py-32 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto text-left space-y-6">
      <span class="inline-block px-3 py-1 rounded text-[11px] font-bold uppercase tracking-[0.18em] bg-[#FF1E38]/10 text-[#FF1E38] border border-[#FF1E38]/20">
        SEDE LIMA, PERÚ • ATENCIÓN DIRECTA
      </span>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold font-display uppercase tracking-tight text-[#FFFFFF] leading-[0.95]">
        HABLEMOS DE TU PROYECTO
      </h1>
      <p class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal">
        Sin ejecutivos de ventas que no entienden de arquitectura. Conversá directamente con ingenieros de software para definir alcance, stack y cronograma.
      </p>

      <div class="pt-4">
        <Button 
          variant="whatsapp" 
          size="lg" 
          href="https://wa.me/51999999999?text=Hola%20Vizcatch,%20quiero%20conversar%20sobre%20un%20proyecto%20de%20software"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsApp class="w-4 h-4" />
          <span>Escribir por WhatsApp (+51)</span>
        </Button>
      </div>
    </Container>
  </section>

  <!-- Request for Proposal Form Section -->
  <ContactForm />

  <Faq />
</BaseLayout>
