---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import Button from '../../components/common/Button.astro';
import WhatsApp from '../../components/icons/WhatsApp.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';

const modules = [
  { index: '01', title: 'Gestión de Leads & Pipeline Comercial', desc: 'Embudos visuales adaptados al proceso de venta de tu empresa con estados configurables y seguimiento de cada oportunidad.' },
  { index: '02', title: 'Integración WhatsApp Web & API Oficial', desc: 'Comunicate con prospectos directamente desde la ficha del cliente y guardá el historial de conversaciones automáticamente.' },
  { index: '03', title: 'Facturación SUNAT en 1 Solo Click', desc: 'Generá boletas y facturas electrónicas válidas directamente desde las cotizaciones ganadas sin doble digitación.' },
  { index: '04', title: 'Permisos & Auditoría Granular por Roles', desc: 'Controlá qué información ve cada asesor comercial, supervisor o gerente con registro de actividad en tiempo real.' },
  { index: '05', title: 'Control de Cobranzas y Cuentas por Cobrar', desc: 'Seguimiento de cuentas por cobrar, alertas automáticas de vencimiento por correo/WhatsApp y conciliación de abonos.' },
  { index: '06', title: 'Dashboards & Exportación Contable', desc: 'Reportes en vivo de ventas, comisiones de vendedores y exportación limpia a Excel o sistemas contables (Concar, Siscont).' }
];
---

<BaseLayout
  title="Desarrollo de CRMs y Sistemas de Gestión a Medida en Puno, Perú | Vizcatch Analytics"
  description="Creamos CRMs y paneles administrativos a medida para empresas peruanas. Automatización de ventas, WhatsApp API, facturación SUNAT y cero licencias mensuales."
>
  <!-- Hero Service -->
  <section class="py-24 lg:py-32 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto text-left space-y-6">
      <span class="inline-block px-3 py-1 rounded text-[11px] font-bold uppercase tracking-[0.18em] bg-[#7368CF]/10 text-[#7368CF] border border-[#7368CF]/20">
        SISTEMAS COMERCIALES & CRM
      </span>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold font-display uppercase tracking-tight text-[#FFFFFF] leading-[0.95]">
        CRMS Y PANELES INTERNOS A MEDIDA
      </h1>
      <p class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal">
        Arquitectura comercial diseñada para tu flujo de ventas exacto. Eliminá hojas de cálculo fragmentadas y suscripciones en dólares con software 100% propio.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <Button 
          variant="whatsapp" 
          size="lg" 
          href="https://wa.me/51965100861?text=Hola%20Vizcatch,%20quiero%20cotizar%20un%20CRM%20a%20medida%20para%20mi%20empresa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsApp class="w-4 h-4" />
          <span>Cotizar CRM por WhatsApp</span>
        </Button>
        <Button variant="outline" size="lg" href="/contacto">
          <span>Solicitar Propuesta Técnica</span>
        </Button>
      </div>
    </Container>
  </section>

  <!-- Modules Grid -->
  <section class="py-24 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-5xl mx-auto space-y-16">
      <SectionHeading 
        tag="MÓDULOS DE ARQUITECTURA"
        title="CAPACIDADES NATIVAS DEL SISTEMA"
        subtitle="Construimos exclusivamente los módulos que tu operación necesita, sin interfaces genéricas ni dependencias costosas."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modules.map((m) => (
          <div class="p-8 rounded-lg bg-[#101114] border border-[#23242A] hover:border-[#383942] transition-colors flex flex-col justify-between space-y-4">
            <div>
              <div class="text-[11px] font-bold text-[#7368CF] tracking-[0.18em] uppercase mb-2">{m.index}</div>
              <h3 class="text-lg font-bold text-[#FFFFFF] tracking-tight mb-2">{m.title}</h3>
              <p class="text-xs text-[#A1A1AA] leading-relaxed font-normal">{m.desc}</p>
            </div>
            <div class="pt-3 border-t border-[#23242A] text-[11px] text-[#A1A1AA] font-medium uppercase tracking-wider">
              Módulo a Medida
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <CtaBanner />
</BaseLayout>
