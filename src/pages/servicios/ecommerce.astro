---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";
import Button from "../../components/common/Button.astro";
import WhatsApp from "../../components/icons/WhatsApp.astro";
import PeruPayments from "../../components/illustrations/PeruPayments.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";

const perks = [
  {
    index: "01",
    title: "Checkout Ultrarrápido en 1 Paso",
    desc: "Minimizá el abandono de carritos con un flujo de pago optimizado que procesa pedidos en menos de 2 segundos.",
  },
  {
    index: "02",
    title: "Yape & Plin con QR Dinámico",
    desc: "Los clientes escanean el QR desde su celular y la orden se aprueba automáticamente en tu panel sin revisión manual.",
  },
  {
    index: "03",
    title: "Niubiz & Culqi Tokenizado",
    desc: "Aceptá todas las tarjetas de crédito y débito con los más altos estándares de seguridad PCI-DSS y 3D Secure 2.0.",
  },
  {
    index: "04",
    title: "Facturación Electrónica SUNAT Nativa",
    desc: "Emisión y envío automático de Boleta o Factura XML y PDF al correo del cliente en el instante de la compra.",
  },
  {
    index: "05",
    title: "Sincronización de Stock en Tiempo Real",
    desc: "Conexión con tu almacén o sistema contable para evitar sobreventas durante picos de demanda.",
  },
];
---

<BaseLayout
  title="Desarrollo de E-commerce a Medida en Puno, Perú | Vizcatch Analytics"
  description="Tiendas online full-code de alto tráfico en Perú. Integración nativa con Niubiz, Culqi, Yape, Plin y facturación electrónica SUNAT. Cero caídas en CyberDays."
>
  <!-- Hero Section -->
  <section class="py-24 lg:py-32 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto text-left space-y-6">
      <span
        class="inline-block px-3 py-1 rounded text-[11px] font-bold uppercase tracking-[0.18em] bg-[#7368CF]/10 text-[#7368CF] border border-[#7368CF]/20"
      >
        COMERCIO ELECTRÓNICO & CHECKOUT
      </span>
      <h1
        class="text-4xl sm:text-6xl lg:text-7xl font-bold font-display uppercase tracking-tight text-[#FFFFFF] leading-[0.95]"
      >
        E-COMMERCE DE ALTO TRÁFICO A MEDIDA
      </h1>
      <p
        class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal"
      >
        Arquitectura full code con checkout en un solo paso, integración con
        Niubiz, Culqi, Yape, Plin y facturación electrónica SUNAT. Cero
        comisiones de plataforma, cero caídas en CyberDays.
      </p>

      <div
        class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3"
      >
        <Button
          variant="whatsapp"
          size="lg"
          href="https://wa.me/51965100861?text=Hola%20Vizcatch,%20quiero%20cotizar%20un%20E-commerce%20a%20medida%20para%20mi%20empresa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsApp class="w-4 h-4" />
          <span>Cotizar E-commerce por WhatsApp</span>
        </Button>
        <Button variant="outline" size="lg" href="/contacto">
          <span>Calcular Presupuesto</span>
        </Button>
      </div>

      <div class="pt-6">
        <PeruPayments />
      </div>
    </Container>
  </section>

  <!-- Perks Grid -->
  <section class="py-24 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-5xl mx-auto space-y-16">
      <SectionHeading
        tag="VENTAJAS DE INGENIERÍA"
        title="CONSTRUIDO PARA VENDER A ESCALA MASIVA"
        subtitle="Dejá atrás la fragilidad de plugins de terceros y las pasarelas de pago desactualizadas."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          perks.map((p) => (
            <div class="p-8 rounded-lg bg-[#101114] border border-[#23242A] hover:border-[#383942] transition-colors flex flex-col justify-between space-y-4">
              <div>
                <div class="text-[11px] font-bold text-[#7368CF] tracking-[0.18em] uppercase mb-2">
                  {p.index}
                </div>
                <h3 class="text-lg font-bold text-[#FFFFFF] tracking-tight mb-2">
                  {p.title}
                </h3>
                <p class="text-xs text-[#A1A1AA] leading-relaxed font-normal">
                  {p.desc}
                </p>
              </div>
              <div class="pt-3 border-t border-[#23242A] text-[11px] text-[#A1A1AA] font-medium uppercase tracking-wider">
                Rendimiento Garantizado
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <CtaBanner />
</BaseLayout>
