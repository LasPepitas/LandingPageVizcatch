---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import Button from '../../components/common/Button.astro';
import WhatsApp from '../../components/icons/WhatsApp.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';

const services = [
  { index: '01', title: 'Desarrollo de APIs REST & GraphQL', desc: 'Servicios web altamente concurrentes, seguros y documentados bajo OpenAPI/Swagger con Node.js o Go.' },
  { index: '02', title: 'Bases de Datos & Optimización SQL', desc: 'Modelado relacional en PostgreSQL, indexación avanzada, replicación y caching en memoria con Redis.' },
  { index: '03', title: 'Migración & Modernización Cloud', desc: 'Llevamos tus sistemas legados monolíticos a una arquitectura Cloud moderna en AWS con microservicios y contenedores Docker.' },
  { index: '04', title: 'Automatización & Microservicios', desc: 'Conexión de sistemas dispersos, webhooks, colas de mensajes (RabbitMQ/SQS) y procesos en background.' }
];
---

<BaseLayout
  title="Desarrollo de Software a Medida & Arquitectura Cloud en Puno, Perú | Vizcatch Analytics"
  description="Ingeniería de software a medida, APIs REST, bases de datos PostgreSQL y modernización cloud en Perú. Código limpio, robusto y escalable."
>
  <!-- Hero Section -->
  <section class="py-24 lg:py-32 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto text-left space-y-6">
      <span class="inline-block px-3 py-1 rounded text-[11px] font-bold uppercase tracking-[0.18em] bg-[#7368CF]/10 text-[#7368CF] border border-[#7368CF]/20">
        INGENIERÍA DE BACKEND & CLOUD
      </span>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold font-display uppercase tracking-tight text-[#FFFFFF] leading-[0.95]">
        SOFTWARE CLOUD Y APIS A MEDIDA
      </h1>
      <p class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal">
        Diseño de arquitecturas distribuidas, APIs de alta concurrencia, bases de datos PostgreSQL optimizadas y modernización de plataformas críticas en AWS.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <Button 
          variant="whatsapp" 
          size="lg" 
          href="https://wa.me/51965100861?text=Hola%20Vizcatch,%20quiero%20cotizar%20un%20proyecto%20de%20software%20a%20medida"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsApp class="w-4 h-4" />
          <span>Consultar con un Ingeniero</span>
        </Button>
        <Button variant="outline" size="lg" href="/contacto">
          <span>Agendar Llamada Técnica</span>
        </Button>
      </div>
    </Container>
  </section>

  <!-- Capabilities Grid -->
  <section class="py-24 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto space-y-16">
      <SectionHeading 
        tag="CAPACIDADES TÉCNICAS"
        title="ARQUITECTURA DE NIVEL INDUSTRIAL"
        subtitle="Construimos sistemas robustos y tipados de punta a punta que no requieren parches continuos."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((item) => (
          <div class="p-8 rounded-lg bg-[#101114] border border-[#23242A] hover:border-[#383942] transition-colors space-y-3">
            <div class="text-[11px] font-bold text-[#7368CF] tracking-[0.18em] uppercase">{item.index}</div>
            <h3 class="text-lg font-bold text-[#FFFFFF] tracking-tight">{item.title}</h3>
            <p class="text-xs text-[#A1A1AA] leading-relaxed font-normal">{item.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <CtaBanner />
</BaseLayout>
