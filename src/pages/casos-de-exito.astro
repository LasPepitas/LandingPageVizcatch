---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import CtaBanner from "../components/sections/CtaBanner.astro";

const cases = [
  {
    client: "Endogastro Puno",
    industry: "Centro de Especialidades Médicas",
    problem:
      "Página web y sistema interno legado, no lograban procesar transacciones ni reservar citas de forma virtual y presencial, conexión con máquinas de laboratorio y tienda de farmacia.",
    solution:
      "ERP completo a medida para la clínica con reserva de citas, conexión de laboratorios y farmacia. Desarrollo de aplicación mobile nativa disponible en Android y iPhone.",
    results: [
      "Aumento del 100% en reservas online",
      "Reducción del 60% en carga administrativa",
      "Integración exitosa con App Store y Google Play"
    ],
    tech: ["React Native", "Expo", "Node.js", "PostgreSQL", "React"]
  },
  {
    client: "Grupo Inmobiliario Siena",
    industry: "Inmobiliaria",
    problem:
      "Requerían mostrar sus proyectos y captar leads segmentados por interés y fuente, además de un CRM para centralizar clientes provenientes de múltiples redes.",
    solution:
      "Landing page optimizada y CRM a medida con gestión de leads, usuarios y contenido web. Integración total con ecosistema de Google y WhatsApp Oficial.",
    results: [
      "Centralización automática de leads omnicanal",
      "Gestión de citas automatizada con Google Calendar y Tasks",
      "Posicionamiento SEO estructurado en motores de búsqueda"
    ],
    tech: ["Astro", "React", "Node.js", "WhatsApp Cloud API", "Google APIs"]
  }
];
---

<BaseLayout
  title="Casos de Éxito en Desarrollo de Software en Puno, Perú | Vizcatch Analytics"
  description="Conocé cómo empresas peruanas aumentaron su facturación y optimizaron sus operaciones con nuestras soluciones full code de CRMs, E-commerce y Landings."
>
  <!-- Header -->
  <section class="py-24 lg:py-32 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto text-left space-y-6">
      <span
        class="inline-block px-3 py-1 rounded text-[11px] font-bold uppercase tracking-[0.18em] bg-[#7368CF]/10 text-[#7368CF] border border-[#7368CF]/20"
      >
        PROYECTOS & CASOS DE ESTUDIO
      </span>
      <h1
        class="text-4xl sm:text-6xl lg:text-7xl font-bold font-display uppercase tracking-tight text-[#FFFFFF] leading-[0.95]"
      >
        CASOS DE ESTUDIO & RESULTADOS
      </h1>
      <p
        class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal"
      >
        Proyectos de ingeniería de software implementados en producción para
        empresas que exigen alta disponibilidad, velocidad sub-segundo y
        soberanía de código.
      </p>
    </Container>
  </section>

  <!-- Cases List -->
  <section class="py-24 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-5xl mx-auto space-y-10">
      {
        cases.map((c) => (
          <div class="rounded-lg border border-[#23242A] bg-[#101114] p-8 sm:p-10 hover:border-[#383942] transition-colors">
            <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-[#23242A]">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#7368CF] bg-[#7368CF]/10 border border-[#7368CF]/20 px-2.5 py-1 rounded">
                  {c.industry}
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-[#FFFFFF] tracking-tight mt-3">
                  {c.client}
                </h2>
              </div>
              <div class="flex flex-wrap gap-2 text-xs">
                {c.tech.map((t) => (
                  <span class="px-3 py-1 rounded bg-[#18191E] text-[#FFFFFF] text-xs border border-[#2A2B32] font-medium">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
              <div class="space-y-6">
                <div>
                  <h3 class="text-[11px] font-bold text-[#7368CF] uppercase tracking-[0.18em] mb-1.5 font-sans">
                    El Desafío / Problema:
                  </h3>
                  <p class="text-sm text-[#A1A1AA] leading-relaxed font-normal">
                    {c.problem}
                  </p>
                </div>

                <div>
                  <h3 class="text-[11px] font-bold text-[#FFFFFF] uppercase tracking-[0.18em] mb-1.5 font-sans">
                    Solución de Ingeniería:
                  </h3>
                  <p class="text-sm text-[#FFFFFF] leading-relaxed font-normal">
                    {c.solution}
                  </p>
                </div>
              </div>

              <div class="rounded-lg bg-[#18191E] p-6 sm:p-8 border border-[#2A2B32] flex flex-col justify-between space-y-6">
                <div>
                  <div class="text-[11px] font-bold text-[#22C55E] uppercase tracking-[0.18em] mb-4">
                    Impacto Operativo Comprobado:
                  </div>
                  <ul class="space-y-2.5">
                    {c.results.map((r) => (
                      <li class="flex items-start gap-2.5 text-xs text-[#FFFFFF] font-medium">
                        <span class="w-1.5 h-1.5 bg-[#7368CF] rounded-full shrink-0 mt-1.5" />
                        <span>{r}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-4 border-t border-[#2A2B32] text-right">
                  <a
                    href={`https://wa.me/51965100861?text=${encodeURIComponent(`Hola Vizcatch, quiero un proyecto similar al caso de éxito: ${c.client}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-semibold text-[#7368CF] hover:underline"
                  >
                    Consultar caso similar para mi empresa →
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </Container>
  </section>

  <CtaBanner />
</BaseLayout>
