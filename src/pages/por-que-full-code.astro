---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import WhatsApp from '../components/icons/WhatsApp.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const reasons = [
  {
    index: '01',
    title: 'La Trampa de los Plugins: Vulnerabilidades y Caídas Inevitables',
    desc: 'Un sitio típico de WordPress necesita entre 25 y 50 plugins para operar (formularios, pasarelas, caché, seguridad, SEO). Cada plugin es una puerta trasera potencial y un punto único de fallo. Cuando uno de esos plugins se actualiza y entra en conflicto con otro, la web colapsa y el negocio deja de facturar.'
  },
  {
    index: '02',
    title: 'Rendimiento Real vs. Falso Rendimiento de Caché',
    desc: 'Los constructores visuales pesados generan árboles de DOM gigantescos con cientos de kilobytes de JavaScript y CSS que el navegador del usuario debe procesar. En conexiones móviles de 4G en Perú, esto se traduce en 4 a 6 segundos de espera. El código compilado genera HTML estático puro que carga en menos de 0.8s.'
  },
  {
    index: '03',
    title: 'Costo Total de Propiedad (TCO) Oculto a Mediano Plazo',
    desc: 'WordPress parece económico al inicio, pero con el tiempo acumula licencias anuales de plugins en dólares ($50-$200/año c/u), servidores dedicados costosos para compensar el código ineficiente y horas constantes de programadores para parchar caídas. Full Code requiere una inversión inicial clara pero opera en infraestructura cloud económica ($10 a $20/mes).'
  },
  {
    index: '04',
    title: 'Propiedad Intelectual y Soberanía Tecnológica Total',
    desc: 'Cuando construís sobre plantillas, no sos dueño de la tecnología; dependés de un desarrollador de temas que puede abandonar el soporte en cualquier momento. Con Vizcatch, el 100% del código fuente, modelos de datos y lógica de negocio te pertenece a vos.'
  }
];
---

<BaseLayout
  title="Por qué Full Code vs WordPress | Manifiesto Técnico Vizcatch Perú"
  description="Descubrí por qué las empresas que escalan en Perú eligen desarrollo Full Code en vez de plantillas lentas de WordPress. Rendimiento, seguridad y propiedad total."
>
  <!-- Manifesto Header -->
  <section class="py-24 lg:py-32 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto text-left space-y-6">
      <span class="inline-block px-3 py-1 rounded text-[11px] font-bold uppercase tracking-[0.18em] bg-[#FF1E38]/10 text-[#FF1E38] border border-[#FF1E38]/20">
        MANIFIESTO DE INGENIERÍA
      </span>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold font-display uppercase tracking-tight text-[#FFFFFF] leading-[0.95]">
        POR QUÉ CONSTRUIMOS EXCLUSIVAMENTE FULL CODE
      </h1>
      <p class="text-base sm:text-lg text-[#A1A1AA] leading-relaxed max-w-2xl font-normal">
        Una explicación técnica y sin filtros sobre por qué los constructores visuales y las plantillas sobrecargadas frenan el crecimiento de las empresas digitales en Perú.
      </p>

      <div class="pt-4">
        <Button 
          variant="whatsapp" 
          size="lg" 
          href="https://wa.me/51999999999?text=Hola%20Vizcatch,%20quiero%20conversar%20sobre%20migrar%20mi%20sitio%20a%20Full%20Code"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsApp class="w-4 h-4" />
          <span>Consultar Migración a Full Code</span>
        </Button>
      </div>
    </Container>
  </section>

  <!-- Deep Technical Points -->
  <section class="py-24 bg-[#080808] border-b border-[#23242A]">
    <Container class="max-w-4xl mx-auto space-y-6">
      {reasons.map((r) => (
        <div class="p-8 sm:p-10 rounded-lg bg-[#101114] border border-[#23242A] hover:border-[#383942] transition-colors space-y-3">
          <div class="text-[11px] font-bold text-[#FF1E38] tracking-[0.18em] uppercase">{r.index}</div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#FFFFFF] tracking-tight">
            {r.title}
          </h2>
          <p class="text-sm text-[#A1A1AA] leading-relaxed font-normal">
            {r.desc}
          </p>
        </div>
      ))}
    </Container>
  </section>

  <CtaBanner />
</BaseLayout>
